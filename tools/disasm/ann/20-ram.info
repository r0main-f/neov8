# ---- RAM map annotations (battery RAM layout, edit buffers, step/program I/O, MIDI rings) ----
# Side convention in the stock code: side index 0 = RIGHT, 1 = LEFT (see docs/rev4-ram-map.md).

# --- zero page ---
LABEL { NAME "zPtrMem";      ADDR $0E; SIZE 2; COMMENT "ptr to program ($4000+40n) / step ($5000+24n) / scratch"; };
LABEL { NAME "zOctR";        ADDR $15; COMMENT "octave R (0-2), step byte3 b7-6"; };
LABEL { NAME "zOctL";        ADDR $16; COMMENT "octave L (0-2), step byte4 b7-6"; };
