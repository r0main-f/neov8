# ---- Sound engine, CV/S&H, PTM, autotune (fork C) ----
# Interrupt / tick structure
LABEL { NAME "IRQ_HANDLER";       ADDR $80B2; COMMENT "IRQ: poll PIA2 CA1 (ext clk), PTM T1 (int clk) -> $07F3; PTM T2 (tick) -> $07F1; then CLI and run pending work unless $07F0/$07F5 set"; };
LABEL { NAME "CTRL_TICK";         ADDR $8127; COMMENT "control tick, once per PTM T2 timeout (4097 cyc = 2.0485 ms); 3-phase round robin on $2B"; };
LABEL { NAME "RUN_DEFERRED_TICKS";ADDR $B364; COMMENT "if ticks/clocks pending and not busy: fake an IRQ (push $B37D, PHP, JMP $8006)"; };
LABEL { NAME "ARP_CLOCK_TICK";    ADDR $948F; COMMENT "per T1/ext-clock event: arp/seq step divider ($0978 from ARP_DIV_TBL), PIA2 CB2 pulse"; };
LABEL { NAME "ARP_DIV_TBL";       ADDR $948C; SIZE 3; COMMENT "clock events per arp step: 96/48/24 (minus 1)"; };
# CV refresh
LABEL { NAME "REFRESH_GRP_END";   ADDR $800F; SIZE 6; COMMENT "group refresh: slot index stop (exclusive)"; };
LABEL { NAME "REFRESH_GRP_START"; ADDR $8015; SIZE 6; COMMENT "group refresh: slot index start (counts down)"; };
LABEL { NAME "CV_REFRESH_STEP";   ADDR $801B; COMMENT "1 of 3 calls: next slot group ($B0 5..0); else next voice channel ($805B); interleaves VPK-5 clocks"; };
LABEL { NAME "CV_REFRESH_VOICECH";ADDR $805B; COMMENT "channel c=$B2: slots c+$18..c (L voices) if $0980+c bit7, c+$38..c+$20 (R) if $0988+c; wrap -> MIDICV_REFRESH"; };
LABEL { NAME "CV_REFRESH_4SLOTS"; ADDR $8089; COMMENT "write 4 slots X, X-8, X-16, X-24 from $0500/$0580"; };
LABEL { NAME "CV_REFRESH_ALL128"; ADDR $C5D1; COMMENT "write all 128 slots from $0500/$0580 (autotune / init)"; };
LABEL { NAME "MIDICV_REFRESH";    ADDR $CEFA; COMMENT "refresh A7=1 slots $3080-$3087 (MIDI controller CVs) from $0740/$0748"; };
LABEL { NAME "MIDICV_WRITE1";     ADDR $CF0B; COMMENT "write one MIDI controller CV slot Y"; };
LABEL { NAME "MIDICV_SETSLOT";    ADDR $CF1A; COMMENT "DAC <- $0740/$0748,Y, mDAC <- $FF (Y<4) or $0751; STA $3000,Y then $3080,Y"; };
# Envelopes
LABEL { NAME "ENV_OUTPUT_ALL";    ADDR $8A00; COMMENT "phase 0: 16 ADSRs; ADSR2 v -> slot $68+v (mDAC velocity), ADSR1 v -> $70+v (mDAC Fc depth); ADSR->PWM slots 8v+1/8v+5"; };
LABEL { NAME "ENV_DISPATCH";      ADDR $8DEA; COMMENT "JMP ($00A6): A = state ($0360,X) | mode/gate base ($98-$9B, $03E0+v)"; };
LABEL { NAME "ENV_JT";            ADDR $8900; COMMENT "8 dispatch tables x 7 JMPs at $8900+$20*k"; };
LABEL { NAME "ENV_ENTER_A";       ADDR $8DEF; COMMENT "state entry: level -> table position via ENV_INV"; };
LABEL { NAME "ENV_ENTER_B";       ADDR $8E03; };
LABEL { NAME "ENV_DECAY";         ADDR $8E15; COMMENT "segment using rate $0900/$0910, target $0960 (sustain)"; };
LABEL { NAME "ENV_RELEASE";       ADDR $8EAA; COMMENT "segment using rate $0920/$0930"; };
LABEL { NAME "ENV_HOLD";          ADDR $8F2C; COMMENT "idle/sustain: output current level"; };
LABEL { NAME "ENV_ATTACK";        ADDR $8F39; COMMENT "segment using rate $0940/$0950"; };
LABEL { NAME "ENV_RESTART_VOICE"; ADDR $A61B; COMMENT "note-on: immediate ADSR1/ADSR2 output for one voice"; };
LABEL { NAME "ENV_RESET_ALL";     ADDR $E0E9; };
LABEL { NAME "ENV_RATE_HI";       ADDR $8800; COMMENT "128 x rate MSB for ADSR time params"; };
LABEL { NAME "ENV_RATE_LO";       ADDR $8880; COMMENT "128 x rate LSB"; };
LABEL { NAME "ENV_CURVE";         ADDR $D000; COMMENT "$D000-$D7FF: 1024-entry 14-bit level->DAC curve, 4 interleaved PA/PB page pairs (frac bits 00,01,10,11 = D0/D1,D2/D3,D4/D5,D6/D7)"; };
LABEL { NAME "ENV_INV";           ADDR $D800; COMMENT "256: inverse curve, level*2 -> table position"; };
LABEL { NAME "PARAM_EXP";         ADDR $D900; COMMENT "256: convex 0..255 curve, param*2 (glide, LFO, prog volume, blink rate)"; };
# Program -> hardware apply
LABEL { NAME "APPLY_PROGRAM_SIDE";ADDR $DEBA; COMMENT "apply program at ($C6) to side $19"; };
LABEL { NAME "APPLY_VCF_FC_STATIC";ADDR $DA30; COMMENT "byte $13 Fc -> slots side*8+$40..$43 when bit7=1"; };
LABEL { NAME "APPLY_VCF_Q_VOLS";  ADDR $DA4A; COMMENT "bytes $10,$11,$12 -> slots side*8+$44,$45,$46 (VCO1 vol, VCO2 vol, Q)"; };
LABEL { NAME "APPLY_VCO1_PITCH_STATIC"; ADDR $DA64; COMMENT "VCO1 not kbd-tracked: pitch -> ch7 of side voices"; };
LABEL { NAME "APPLY_NOISE";       ADDR $DAAF; COMMENT "byte $0C -> slot side*4+$52"; };
LABEL { NAME "MOD_HW_INIT";       ADDR $DAC0; COMMENT "clear crosspoints ($65xx), reprogram both sides"; };
LABEL { NAME "APPLY_XPT";         ADDR $DB22; COMMENT "mod bank controllers/invert -> ANA I CD22100 crosspoints $65xx"; };
LABEL { NAME "APPLY_LS670";       ADDR $DBE1; COMMENT "mod bank sources -> DIGIMOD 74LS670 $66xx/$67xx (word = A4:A3, data D4-D7)"; };
LABEL { NAME "APPLY_PROG_VOLUME"; ADDR $DC37; COMMENT "byte $21 via PARAM_EXP -> $0553+side*4 (slot $53/$57)"; };
LABEL { NAME "APPLY_PWM";         ADDR $DC92; COMMENT "byte $25 depths -> $0990/$0998, byte $20 sources -> $09A8, flags $88-$8F, $0981.. refresh enables"; };
LABEL { NAME "APPLY_INIT_PW";     ADDR $DD66; COMMENT "bytes $0F/$26 + PW cal $59C0 -> ch6/ch2; ch5/ch1 <- $0404"; };
LABEL { NAME "APPLY_MOD_DEPTHS";  ADDR $DDF6; COMMENT "bytes $06-$09 -> slots side*4+$60..$63"; };
LABEL { NAME "APPLY_GLIDE";       ADDR $DE30; };
LABEL { NAME "APPLY_LFO1_DELAY";  ADDR $DE5F; };
LABEL { NAME "APPLY_WAVE_LATCHES";ADDR $DEF3; COMMENT "bytes $14-$1B bit7 -> $61xx (L) / $62xx (R) CD4724 Q0-Q7; waveform level comp -> $057B"; };
LABEL { NAME "WAVE_LEVEL_COMP";   ADDR $DEE1; SIZE 3; };
LABEL { NAME "APPLY_LIN_FM";      ADDR $DF37; COMMENT "byte $22 bit7 -> $6300+side (IC3 Q0/Q1 LIN FM)"; };
LABEL { NAME "APPLY_ENV_PARAMS";  ADDR $E521; COMMENT "ADSR params; $90+side <- vel-VCA flag (byte $1C), $92+side <- byte $14*2 (ADSR1->Fc depth)"; };
LABEL { NAME "VCF_REFRESH_ALL";   ADDR $E427; COMMENT "slots $40-$57 from $0540 (PB=0)"; };
LABEL { NAME "NOTE_ON_CV";        ADDR $ED97; COMMENT "note-on: pitch slots 8v+3/8v+7, Fc slot $40+v, velocity slot $58+v, kbd-tracked PWM depth"; };
LABEL { NAME "VOLUME_GATE";       ADDR $F90D; COMMENT "every phase 0: if no ADSR2 active, program volume /4 (slots $53/$57)"; };
LABEL { NAME "GLIDE_LEFT";        ADDR $AE50; };
LABEL { NAME "GLIDE_RIGHT";       ADDR $AE67; };
LABEL { NAME "GLIDE_VOICE";       ADDR $AD30; };
# LFOs
LABEL { NAME "LFO_PWM_VCO1";      ADDR $FCE2; COMMENT "LFO-sourced PWM, VCO1 (ch5), both sides"; };
LABEL { NAME "LFO_PWM_VCO2";      ADDR $FCE6; COMMENT "LFO-sourced PWM, VCO2 (ch1)"; };
LABEL { NAME "LFO_PWM_WRITE4";    ADDR $FD23; };
LABEL { NAME "LFO2_TICK";         ADDR $FD5B; COMMENT "phase 2: LFO2 L,R"; };
LABEL { NAME "LFO1_TICK";         ADDR $FD64; COMMENT "phase 1: LFO1 L,R"; };
LABEL { NAME "LFO_UPDATE";        ADDR $FD77; COMMENT "X = lfo#*2 + side; value -> $0579+side*4+lfo#, slot $79+..; LFO1 offset -> $78/$7C"; };
LABEL { NAME "LFO1_SQ_LATCH";     ADDR $FE6D; COMMENT "LFO1 square -> $6305+side (IC3 Q5/Q6)"; };
LABEL { NAME "LFO1_DELAY_FADE";   ADDR $FF7B; COMMENT "delay fade-in -> mDAC $0578"; };
LABEL { NAME "RANDOM8";           ADDR $FFE1; COMMENT "8-bit LFSR in $28 (S&H)"; };
# PTM / clocks
LABEL { NAME "PIA_CX2_WRITE";     ADDR $A682; COMMENT "X=0..3: PIA1 CA2, PIA1 CB2, PIA2 CA2, PIA2 CB2 <- A bit3 (shadow $070C-$070F)"; };
LABEL { NAME "PTM_SET_T1_TEMPO";  ADDR $A712; COMMENT "T1 latch <- $0977*256"; };
LABEL { NAME "CLOCK_SRC_INT";     ADDR $A6AF; };
LABEL { NAME "CLOCK_SRC_STOP";    ADDR $A745; };
LABEL { NAME "TEMPO_TO_T1";       ADDR $B657; COMMENT "A=BPM -> A=T1 MSB, Y=representable BPM"; };
LABEL { NAME "TEMPO_T1_TABLE";    ADDR $B66D; COMMENT "236 entries, index BPM-20; $FF = not representable (step down)"; };
LABEL { NAME "IO_INIT_TBL";       ADDR $E989; COMMENT "boot I/O init: (value, lo, hi) triples, executed last to first"; };
# Autotune ($C000 bank)
LABEL { NAME "AUTOTUNE";          ADDR $C124; COMMENT "entry via $C003; SEI for whole run; osc $047A = 15..0 (odd = VCO1)"; };
LABEL { NAME "AT_PTM_SETUP";      ADDR $C018; COMMENT "T1 gated continuous (G1 = VCO DETECT), T3 one-shot timeout, T2 latch $2000"; };
LABEL { NAME "AT_SELECT_OSC";     ADDR $C043; COMMENT "$6302/$6303 VCO2/VCO1 SEL; $307F then $6400-$6402 = voice (VCO tune mux)"; };
LABEL { NAME "AT_INIT_CV";        ADDR $C066; };
LABEL { NAME "AT_WAIT_PA7_HI";    ADDR $C0CC; };
LABEL { NAME "AT_WAIT_PA7_LO";    ADDR $C0D5; };
LABEL { NAME "AT_CLEAR_DIV";      ADDR $C0EA; COMMENT "pulse PIA1 CB2 (clear LS74 divider)"; };
LABEL { NAME "AT_PTM_LATCH_FFFF"; ADDR $C0FA; };
LABEL { NAME "AT_TIMEOUT_CHECK";  ADDR $C116; COMMENT "T3 flag -> error A"; };
LABEL { NAME "AT_FINISH";         ADDR $C14F; COMMENT "save cal, restore PTM, CLI, return"; };
LABEL { NAME "AT_ERROR";          ADDR $C27B; COMMENT "show error letter (A..d) in digit 4, mark voice in $F3, next osc"; };
LABEL { NAME "AT_WAVE_LATCH_OFF"; ADDR $C2C7; };
LABEL { NAME "AT_TUNE_OFFSET";    ADDR $C2D5; };
LABEL { NAME "AT_TUNE_SCALE";     ADDR $C348; };
LABEL { NAME "AT_MEASURE_PERIOD"; ADDR $C3FA; COMMENT "read gated PTM T1 (EOR $FF), repeat until 2 readings agree"; };
LABEL { NAME "AT_WRITE_OSC_CV";   ADDR $C4FC; COMMENT "write the 4 slots of the current osc with long settle"; };
LABEL { NAME "AT_MEASURE_DUTY";   ADDR $C55E; COMMENT "software count of PA7 high vs low time -> PW cal"; };
LABEL { NAME "AT_SAVE_PWCAL";     ADDR $C62D; };
LABEL { NAME "PTM_RESTORE";       ADDR $C64E; COMMENT "normal PTM setup: T2 latch $1000, T3 latch $111C"; };
LABEL { NAME "XPT_CLEAR_ALL";     ADDR $C6CF; };
LABEL { NAME "IC22_WRITE_BYTE";   ADDR $C719; COMMENT "STA $307F then 8 bits -> $6400-$6407 (DIGIMOD IC22: pot/VCO mux address)"; };
LABEL { NAME "POT_MUX_ORDER";     ADDR $C009; SIZE 15; };
# Engine RAM
LABEL { NAME "CV_PA";             ADDR $0500; COMMENT "128 slot images, PIA1 PA (DAC bits 13-7)"; };
LABEL { NAME "CV_PB";             ADDR $0580; COMMENT "128 slot images, PIA1 PB (DAC bits 6-0 in PB7-PB1)"; };
LABEL { NAME "CV_REFRESH_EN_L";   ADDR $0980; SIZE 8; COMMENT "bit7: static-refresh channel c of voices 0-3"; };
LABEL { NAME "CV_REFRESH_EN_R";   ADDR $0988; SIZE 8; COMMENT "bit7: static-refresh channel c of voices 4-7"; };
LABEL { NAME "PWM1_DEPTH";        ADDR $0990; SIZE 8; COMMENT "per voice VCO1 PWM depth (mDAC)"; };
LABEL { NAME "PWM2_DEPTH";        ADDR $0998; SIZE 8; COMMENT "per voice VCO2 PWM depth (mDAC)"; };
LABEL { NAME "ENV_STATE";         ADDR $0360; SIZE 16; COMMENT "0-7 ADSR1 v0-7, 8-15 ADSR2 v0-7"; };
LABEL { NAME "ENV_LEVEL";         ADDR $07D0; SIZE 16; };
LABEL { NAME "VEL_SCALE";         ADDR $07E0; SIZE 8; COMMENT "per voice velocity -> ADSR2 mDAC"; };
LABEL { NAME "IRQ_BUSY";          ADDR $07F0; };
LABEL { NAME "TICK_PENDING";      ADDR $07F1; };
LABEL { NAME "CLK_PENDING";       ADDR $07F3; };
LABEL { NAME "TICK_DEFER";        ADDR $07F5; COMMENT "nonzero: IRQ only counts; owner calls RUN_DEFERRED_TICKS ($B03E)"; };
LABEL { NAME "TUNE_OFS_HI";       ADDR $0720; SIZE 16; };
LABEL { NAME "TUNE_OFS_LO";       ADDR $0730; SIZE 16; };
LABEL { NAME "T1_MSB";            ADDR $0977; };
LABEL { NAME "TEMPO_BPM";         ADDR $097E; };
LABEL { NAME "PIA_CR_SHADOW";     ADDR $070C; SIZE 4; };
LABEL { NAME "TICK_PHASE";        ADDR $002B; };
LABEL { NAME "POT_DIV";           ADDR $0034; };
LABEL { NAME "REF_GRP";           ADDR $00B0; };
LABEL { NAME "REF_DIV3";          ADDR $00B1; };
LABEL { NAME "REF_VCH";           ADDR $00B2; };
# data ranges
RANGE { START $D000; END $D9FF; TYPE ByteTable; };
RANGE { START $8800; END $88FF; TYPE ByteTable; };
RANGE { START $B66D; END $B758; TYPE ByteTable; };
